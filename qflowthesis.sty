\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{qflowthesis}[2026/07/24 Professional RUET thesis styling]

\RequirePackage{fontspec}
\IfFontExistsTF{Times New Roman}
  {\setmainfont{Times New Roman}}
  {\IfFontExistsTF{TeX Gyre Termes}
    {\setmainfont{TeX Gyre Termes}}
    {\setmainfont{Latin Modern Roman}}}
\setsansfont{Latin Modern Sans}
\setmonofont[Scale=0.88]{Latin Modern Mono}

\RequirePackage[left=1.0in,right=1.0in,top=2.50cm,bottom=1.0in]{geometry}
\RequirePackage{setspace}
\onehalfspacing
\setlength{\emergencystretch}{2em}
\RequirePackage{microtype}
\RequirePackage{amsmath,amssymb,mathtools,bm}
\RequirePackage{graphicx}
\RequirePackage{booktabs,tabularx,longtable,array,multirow,makecell,threeparttable}
\RequirePackage{enumitem}
\setlist[itemize]{leftmargin=1.6em,itemsep=2pt,topsep=4pt}
\setlist[enumerate]{leftmargin=1.8em,itemsep=2pt,topsep=4pt}
\RequirePackage{float}
\RequirePackage{caption}
\RequirePackage{subcaption}
\captionsetup{font=small,labelfont=bf,labelsep=period,justification=centering}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,positioning,calc,shapes.geometric,fit,backgrounds,matrix,decorations.pathreplacing}
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18}
\RequirePackage{listings}
\RequirePackage{xcolor}
\definecolor{QFlowNavy}{HTML}{17365D}
\definecolor{QFlowBlue}{HTML}{2F5597}
\definecolor{QFlowTeal}{HTML}{2A7F7F}
\definecolor{QFlowGreen}{HTML}{3B7A57}
\definecolor{QFlowAmber}{HTML}{B66A00}
\definecolor{QFlowRed}{HTML}{A61B1B}
\definecolor{QFlowLightBlue}{HTML}{EAF1F8}
\definecolor{QFlowLightGreen}{HTML}{EAF5EE}
\definecolor{QFlowLightAmber}{HTML}{FFF4DF}
\definecolor{QFlowLightRed}{HTML}{FBEAEA}
\definecolor{QFlowGray}{HTML}{667085}
\definecolor{QFlowLine}{HTML}{CBD5E1}

\RequirePackage{titlesec}
\titleformat{\chapter}[display]
  {\normalfont\bfseries\centering}
  {\fontsize{14pt}{17pt}\selectfont CHAPTER \thechapter}
  {0.6ex}
  {\fontsize{16pt}{19pt}\selectfont\MakeUppercase}
\titlespacing*{\chapter}{0pt}{-20pt}{26pt}
\titleformat{\section}{\normalfont\bfseries\fontsize{13pt}{16pt}\selectfont}{\thesection}{0.65em}{}
\titleformat{\subsection}{\normalfont\bfseries\fontsize{12pt}{15pt}\selectfont}{\thesubsection}{0.65em}{}
\titleformat{\subsubsection}{\normalfont\bfseries\itshape\fontsize{12pt}{15pt}\selectfont}{\thesubsubsection}{0.65em}{}

\RequirePackage{tocloft}
\setlength{\cftsecindent}{0cm}
\setlength{\cftsubsecindent}{0.96cm}
\setlength{\cftsubsubsecindent}{2.3cm}
\renewcommand{\cftsecleader}{\cftdotfill{\cftdotsep}}
\renewcommand{\cftsubsecleader}{\cftdotfill{\cftdotsep}}
\renewcommand{\cftsubsubsecleader}{\cftdotfill{\cftdotsep}}
\renewcommand{\cftchapfont}{\bfseries}
\renewcommand{\cftchappagefont}{\normalfont}
\renewcommand{\contentsname}{\hfill\bfseries\Large CONTENTS\hfill}
\renewcommand{\cftaftertoctitle}{\hfill}
\renewcommand{\listfigurename}{\hfill\bfseries\Large LIST OF FIGURES\hfill}
\renewcommand{\listtablename}{\hfill\bfseries\Large LIST OF TABLES\hfill}
\renewcommand{\cftafterloftitle}{\hfill}
\renewcommand{\cftafterlottitle}{\hfill}
\renewcommand{\cftfigdotsep}{\cftnodots}
\renewcommand{\cfttabdotsep}{\cftnodots}

\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\small\itshape\ThesisShortTitle}
\fancyhead[R]{\small\itshape\leftmark}
\fancyfoot[C]{\thepage}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0pt}
\setlength{\headheight}{15pt}
\fancypagestyle{plain}{%
  \fancyhf{}
  \fancyfoot[C]{\thepage}
  \renewcommand{\headrulewidth}{0pt}
}

\RequirePackage{etoolbox}
\AtBeginEnvironment{tabular}{\small}
\AtBeginEnvironment{tabularx}{\small}
\AtBeginEnvironment{longtable}{\small}
\renewcommand{\arraystretch}{1.18}

\RequirePackage{tcolorbox}
\tcbuselibrary{breakable,skins}
\newtcolorbox{keyfinding}[1][]{%
  breakable,colback=QFlowLightBlue,colframe=QFlowBlue,
  boxrule=0.7pt,arc=1.5mm,left=2mm,right=2mm,top=1.5mm,bottom=1.5mm,
  title={Key finding},fonttitle=\bfseries,#1}
\newtcolorbox{pseudocode}[2][]{%
  breakable,colback=white,colframe=QFlowLine,
  boxrule=0.7pt,arc=1mm,left=2mm,right=2mm,top=1.5mm,bottom=1.5mm,
  title={#2},fonttitle=\bfseries,#1}

\RequirePackage{hyperref}
\hypersetup{
  colorlinks=true,
  linkcolor=QFlowNavy,
  citecolor=QFlowGreen,
  urlcolor=QFlowBlue,
  pdftitle={\ThesisTitle},
  pdfauthor={\AuthorName},
  pdfsubject={B.Sc. thesis, Department of CSE, RUET},
  pdfkeywords={QKD network, FPGA, route-candidate evaluation, reinforcement learning, fixed-point hardware}
}
\RequirePackage[capitalise,noabbrev]{cleveref}
\RequirePackage{bookmark}

\lstdefinestyle{qflowcode}{
  basicstyle=\ttfamily\footnotesize,
  keywordstyle=\color{QFlowBlue}\bfseries,
  commentstyle=\color{QFlowGreen},
  stringstyle=\color{QFlowAmber},
  numbers=left,
  numberstyle=\scriptsize\color{QFlowGray},
  numbersep=7pt,
  frame=single,
  rulecolor=\color{QFlowLine},
  breaklines=true,
  showstringspaces=false,
  tabsize=2
}
\lstset{style=qflowcode}

\newcommand{\yesmark}{\textcolor{QFlowGreen}{\bfseries Yes}}
\newcommand{\nomark}{\textcolor{QFlowRed}{\bfseries No}}
\newcommand{\notreported}{\textcolor{QFlowGray}{Not reported}}
\newcommand{\verified}{\textcolor{QFlowGreen}{\bfseries Verified}}
\newcommand{\Hmode}[1]{\textbf{H#1}}
\newcommand{\QFlow}{\textbf{QFlow}}
\newcommand{\QKD}{QKD}

\newcommand{\chapterintro}[1]{%
  \section{Introduction}
  #1
}

\newcommand{\chapterconclusion}[1]{%
  \section{Conclusion}
  #1
}
