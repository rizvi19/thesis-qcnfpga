    "no_path_in",
    "min_key_occupancy_u16",
    "bottleneck_fidelity_u16",
    "offered_request_load_u16",
    "utilization_imbalance_u16",
    "expected_ready",
    "expected_busy",
    "expected_done",
    "expected_output_valid",
    "expected_invalid_state",
    "expected_stall",
    "expected_no_path_out",
    "expected_state_id",
    "expected_proposed_action",
    "expected_selected_action",
    "expected_profile_payload_hex",
    "expected_switched",
    "expected_dwell_count_sat",
